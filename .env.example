# ── Database ────────────────────────────────────────────────────────────
# Production is Aiven Managed PostgreSQL, not a generic self-hosted
# Postgres — a few things follow from that:
#
# 1. Aiven enforces SSL/TLS by default. Your DATABASE_URL MUST include
#    `sslmode=require` (shown below) or the connection will be rejected.
#    `sslmode=verify-full` with Aiven's provided CA certificate pins the
#    cert and is stricter, if you want it — `require` is a reasonable
#    default for this project's threat model.
# 2. pgvector is on Aiven's supported extension list. The migration's
#    `CREATE EXTENSION IF NOT EXISTS vector;` should just work for the
#    default "avnadmin" admin user. If it errors with a permission
#    denied, enable the extension via the Aiven console (Service ->
#    Extensions) or `avn service` CLI first, then re-run the migration —
#    see README.md's "Aiven PostgreSQL notes" section.
# 3. Aiven also offers a PgBouncer connection-pooler URI as an
#    alternative to the direct connection string. Not required at this
#    project's scale; if you do switch to it, note it explicitly in your
#    deployment config (Prisma's `connection_limit` param interacts with
#    poolers) — see README.md.
#
# Local dev (no Aiven, no SSL) example:
#   DATABASE_URL="postgresql://user:password@localhost:5432/journal_platform?schema=public"
# Aiven example (get the exact host/port/user/password from the Aiven
# console's "Connection information" panel for your service):
#   DATABASE_URL="postgresql://avnadmin:PASSWORD@HOST:PORT/defaultdb?sslmode=require"
DATABASE_URL="postgresql://user:password@localhost:5432/journal_platform?schema=public"

# ── Server ──────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=4000

# Comma-separated list of allowed frontend origins (Vercel prod URL +
# any preview URLs + local dev). No trailing slashes.
CORS_ORIGINS="http://localhost:5173"

# ── Sessions (cookie-based auth) ───────────────────────────────────────
# Long, random string. `openssl rand -base64 48`
SESSION_SECRET="change-me-to-a-long-random-string"
# Only set true in production (requires HTTPS, which Render provides).
SESSION_COOKIE_SECURE="false"
# Set to the parent domain when frontend/backend share one, e.g.
# ".example.com" — leave unset for cross-site (Vercel + Render on
# different domains), which is the default for this project.
SESSION_COOKIE_DOMAIN=""

# ── Cloudflare R2 (S3-compatible) ──────────────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="journal-platform-uploads"
# Public base URL for serving uploaded files (R2 public bucket URL, or a
# custom domain fronted by Cloudflare).
R2_PUBLIC_BASE_URL="https://pub-xxxxxxxx.r2.dev"

# ── Email (Resend) ──────────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="IJETDI <noreply@ijetdi.example>"

# ── Frontend ────────────────────────────────────────────────────────────
# Used to build links in emails (password reset, etc.)
FRONTEND_BASE_URL="http://localhost:5173"

# ── AI Research Assistant (Gemini + Tavily) ──────────────────────────────
# Both keys are empty placeholders — never commit a real key. Get them
# from https://aistudio.google.com/apikey (Gemini) and
# https://app.tavily.com (Tavily). If either is unset, the
# /api/research-assistant/query endpoint returns a clean 503 rather than
# crashing the server (see research-assistant.service.ts) — every other
# endpoint works fine without these.
GEMINI_API_KEY=""
TAVILY_API_KEY=""

# Configurable so either model can be swapped without a code change (per
# the feature spec). IMPORTANT: if you change GEMINI_EMBEDDING_MODEL or
# GEMINI_EMBEDDING_DIMENSIONS after chunks already exist in the database,
# you must re-run `npm run ingest` for every article — old embeddings are
# not compatible with a new model/dimension and pgvector inserts will
# fail outright if the dimension doesn't match the column. See
# README.md's "Changing the embedding model" section.
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_GENERATION_MODEL="gemini-2.5-flash"

# Separate, tighter rate limit than the contact form's — this endpoint
# calls paid external APIs on every request.
RESEARCH_ASSISTANT_RATE_LIMIT_WINDOW_MS=60000
RESEARCH_ASSISTANT_RATE_LIMIT_MAX=10
